# ============================================================
# Edvanz Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# All variables must start with VITE_ to be exposed to the browser.
#
# Java Spring Boot backend URL (no trailing slash)
# Example: http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api
#
# Set to "true" to enable request/response logging in the console
VITE_DEBUG_API=false
