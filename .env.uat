# ============================================================
# Edvanz Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# All variables must start with VITE_ to be exposed to the browser.
#
VITE_API_URL=https://api-uat.edvanz.co/api
VITE_EZAI_API_BASE_URL=https://ezai-dev.edvanz.co
# ============================================================
# url for frontend development server
# url for backend development server
# https://api-uat.edvanz.co
#
# Set to "true" to enable request/response logging in the console
VITE_DEBUG_API=true